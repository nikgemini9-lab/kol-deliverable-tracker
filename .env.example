# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Rettiwt (X/Twitter cookie-based auth)
# Get this from your browser cookies after logging into X/Twitter:
# DevTools > Application > Cookies > x.com > auth_token
RETTIWT_API_KEY=your-rettiwt-api-key

# App URL (set this on Render)
NEXT_PUBLIC_APP_URL=http://localhost:3000
